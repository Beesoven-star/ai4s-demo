# LLM API 配置(任意 OpenAI 兼容端点:OpenAI / DeepSeek / 代理网关等)
OPENAI_API_KEY=sk-...
# 可选:覆盖 config.json 的 llm.baseUrl
# OPENAI_BASE_URL=https://api.openai.com/v1

# Feishu Webhook
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/...
# 可选:飞书第三个机器人(推送逻辑与主机器人完全一致,仅 webhook 不同)
# FEISHU_WEBHOOK_URL_1=https://open.feishu.cn/open-apis/bot/v2/hook/...
# 可选:飞书第二机器人(不推 01 专项相关性板块与归档站链接,其余与主机器人一致)
# FEISHU_WEBHOOK_URL_no_teacher=https://open.feishu.cn/open-apis/bot/v2/hook/...

# 可选：添加 token 的免费限额更高，不加也基本够用
# JINA_API_KEY=

# Tavily 搜索 API (tavily.com 注册,免费档 1000 credits/月)
# TAVILY_API_KEY=tvly-...
