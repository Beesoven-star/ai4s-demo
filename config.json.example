      },
      {
        "title": "Science",
        "xmlUrl": "https://www.science.org/action/showFeed?type=etoc&feed=rss&jc=science",
        "category": "AI4S"
      },
      {
        "title": "Science Advances",
        "xmlUrl": "https://www.science.org/action/showFeed?type=etoc&feed=rss&jc=sciadv",
