      },
      {
        "title": "arXiv AI×Science",
        "xmlUrl": "https://export.arxiv.org/api/query?search_query=%28abs%3A%22machine%20learning%22%20OR%20abs%3A%22deep%20learning%22%20OR%20abs%3A%22neural%20network%22%20OR%20abs%3A%22foundation%20model%22%20OR%20abs%3A%22large%20language%20model%22%29%20AND%20%28cat%3Aq-bio.%2A%20OR%20cat%3Acond-mat.%2A%20OR%20cat%3Aphysics.chem-ph%20OR%20cat%3Aphysics.comp-ph%20OR%20cat%3Aphysics.atom-ph%20OR%20cat%3Aastro-ph.%2A%20OR%20cat%3Anlin.%2A%29&sortBy=submittedDate&sortOrder=descending&max_results=50",
        "category": "AI4S"
      },
      {
        "title": "PaperWeekly",
        "xmlUrl": "https://wechat2rss.xlab.app/feed/3be891c2f4e526629ab055a297cc2cd6c1f0a563.xml",
        "category": "AI"
      },
      {
        "title": "我爱计算机视觉",
        "xmlUrl": "https://wechat2rss.xlab.app/feed/b81ffcfff1107b5265cd7e39de610dc7ca72caf4.xml",
        "category": "AI"
      },
      {
        "title": "集智俱乐部",
        "xmlUrl": "https://wechat2rss.xlab.app/feed/8540570d27c0bfe0a219173cf1ace83ae79445cb.xml",
        "category": "AI"
      },
      {
        "title": "夕小瑶科技说",
        "xmlUrl": "https://wechat2rss.bestblogs.dev/feed/64b57d666259aee6bd097e76164e4a8371f0ad04.xml",
        "category": "AI"
      },
      {
        "title": "Microsoft Research",
        "xmlUrl": "https://www.microsoft.com/en-us/research/feed/",
        "category": "Research"
      },
      {
        "title": "DOE Newsroom",
        "xmlUrl": "https://www.energy.gov/newsroom/rss.xml",
        "category": "Research"
      },
      {
        "title": "Berkeley Lab News",
        "xmlUrl": "https://newscenter.lbl.gov/feed/",
        "category": "Research"
      },
      {
        "title": "IT之家",
        "xmlUrl": "https://www.ithome.com/rss/",
        "category": "Media"
      },
      {
        "title": "TechCrunch AI",
        "xmlUrl": "https://techcrunch.com/category/artificial-intelligence/feed/",
        "category": "Media"
      },
      {
        "title": "The Verge AI",
        "xmlUrl": "https://www.theverge.com/rss/ai-artificial-intelligence/index.xml",
        "category": "Media"
      }
    ],
    "block": [],
    "block_domains": [
      "*.substack.com",
      "*.youtube.com"
    ]
  }
}