{
  "filter": {
    "min_score": 60,
    "hot_threshold": 90,
    "context_days": 2,
    "fetch_dedup_days": 3,
    "keep_days": null,
    "archive_keep_days": null,
    "push_context_days": 5,
    "no_content_marker": "[NO_NEW_CONTENT]"
  },
  "web": {
    "host": "127.0.0.1",
    "port": 8000
  },
  "site_sync": {
    "enabled": true,
    "repo_path": "AI4S-Daily-HTML",
    "branch": "main"
  },
  "log": {
    "retention_days": 7
  },
  "notify": {
    "llm_error_push": false
  },
  "schedule": {
    "fetch_interval_minutes": 60,
    "fetch_lookback_minutes": 360,
    "push_cron": [
      "0 8 * * *"
    ],
    "timezone_hours": 8,
    "weekly_cron": [
      "0 17 * * 4",
      "0 17 * * 0"
    ]
  },
  "sections": {
    "weekly": {
      "enabled": true,
      "top_n": 40,
      "top_hot_n": 10
    },
    "hackernews": {
      "enabled": true,
      "select_k": 3,
      "top_comments": 50,
      "top_l2_per_l1": 3,
      "comment_max_chars": 2000,
      "comments_total_chars": 80000,
      "link_content_max_chars": 50000,
      "request_timeout": 30,
      "algolia_base": "https://hn.algolia.com/api/v1",
      "jinaTokenName": "JINA_API_KEY"
    },
    "insights": {
      "enabled": true,
      "top_n": 20
    },
    "gaps": {
      "enabled": false,
      "top_n": 20
    },
    "relevance": {
      "enabled": true,
      "work_dir": "ongoing_work",
      "top_n": 30,
      "work_doc_max_chars": 20000,
      "include_docs": [
        "以往研究内容.docx"
      ]
    }
  },
  "fetch": {
    "max_workers": 10,
    "timeout": 10
  },
  "search": {
    "enabled": true,
    "apiKeyName": "TAVILY_API_KEY",
    "queries": [
      "AI for Science",
      "\"Genesis Mission\"",
      "AI drug discovery",
      "protein design foundation model",
      "AI materials discovery",
      "machine learning chemistry",
      "AI weather climate model",
      "autonomous lab AI scientist"
    ],
    "max_results_per_query": 5,
    "topic": "news",
    "days": 3,
    "max_age_days": 3,
    "search_depth": "basic",
    "interval_hours": 12,
    "request_timeout": 20,
    "content_max_chars": 4000,
    "exclude_domains": [
      "google.com"
    ]
  },
  "llm": {
    "provider": "openai",
    "model": "deepseek-v4-flash",
    "baseUrl": "https://api.deepseek.com",
    "baseUrlName": "OPENAI_BASE_URL",
    "apiKeyName": "OPENAI_API_KEY",
    "max_prompt_chars": 150000,
    "max_concurrent_batches": 3,
    "request_timeout": 600,
    "prompts": {
      "score_batch": "prompts/score_batch.md",
      "immediate_push": "prompts/immediate_push.md",
      "digest": "prompts/digest.md",
      "section_hackernews_select": "prompts/section_hackernews_select.md",
      "section_hackernews": "prompts/section_hackernews.md",
      "insights": "prompts/insights.md",
      "section_gaps": "prompts/section_gaps.md",
      "section_relevance": "prompts/section_relevance.md",
      "weekly": "prompts/weekly.md"
    },
    "monthly_model": "gpt-5.6-terra"
  },
  "push": {
    "discord": {
      "enabled": false,
      "apiKeyName": "DISCORD_WEBHOOK_URL"
    },
    "feishu": {
      "enabled": true,
      "apiKeyName": "FEISHU_WEBHOOK_URL"
    },
    "feishu_1": {
      "enabled": true,
      "apiKeyName": "FEISHU_WEBHOOK_URL_1"
    },
    "feishu_no_teacher": {
      "enabled": true,
      "apiKeyName": "FEISHU_WEBHOOK_URL_no_teacher",
      "exclude_sections": [
        "relevance"
      ],
      "include_archive_link": false
    }
  },
  "sources": {
    "base_opml": [
      "resources/tidings-ai.opml",
      "resources/tidings-research.opml",
      "resources/tidings-engineering.opml",
      "resources/twitter.opml"
    ],
    "add": [
      {
        "title": "OpenAI News",
        "xmlUrl": "https://openai.com/news/rss.xml",
        "category": "AI"
      },
      {
        "title": "Chrome for Developers",
        "xmlUrl": "https://developer.chrome.com/static/blog/feed.xml",
        "category": "Chrome"
      },
      {
        "title": "Cloudflare Developers",
        "xmlUrl": "https://developers.cloudflare.com/changelog/rss/index.xml",
        "category": "Cloudflare"
      },
      {
        "title": "Infoq",
        "xmlUrl": "https://feed.infoq.com/",
        "category": "News"
      },
      {
        "title": "Quanta Magazine",
        "xmlUrl": "https://www.quantamagazine.org/feed/",
        "category": "AI4S"
      },
      {
        "title": "Google Research",
        "xmlUrl": "https://research.google/blog/rss/",
        "category": "AI4S"
      },
      {
        "title": "The Gradient",
