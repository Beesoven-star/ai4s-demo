        "xmlUrl": "https://spectrum.ieee.org/feeds/topic/artificial-intelligence.rss",
        "category": "AI4S"
      },
      {
        "title": "NVIDIA Blog",
        "xmlUrl": "https://blogs.nvidia.com/feed/",
        "category": "AI4S"
      },
      {
        "title": "Nature Machine Learning 主题",
        "xmlUrl": "https://www.nature.com/subjects/machine-learning.rss",
